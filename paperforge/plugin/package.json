{
  "name": "paperforge-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "prepare": "husky",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "pretest:e2e": "npm run build && python test/fixtures/build_e2e_vault.py"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@wdio/cli": "^9.31.7",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.0.8",
    "mocha": "^12.0.0",
    "obsidian": "^1.12.0",
    "obsidian-test-mocks": "^2.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "wdio-obsidian-reporter": "^3.2.0",
    "wdio-obsidian-service": "^3.2.0",
    "webdriverio": "^9.31.7"
  },
  "engines": {
    "node": ">=22"
  }
}
