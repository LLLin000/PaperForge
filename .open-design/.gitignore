# Open Design — project-local install
# Source checkout: .open-design/source (git clone --depth 1)
# Daemon starts on port 17456
#
# Usage:
#   .open-design\daemon.cmd          # start daemon
#   docker compose -f .open-design\deploy\docker-compose.yml up -d   # Docker option
#
# MCP server configured in .omp/mcp.json

.open-design/source
.open-design/deploy/.env
